<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <!-- Pack The Plugin Into "build" Rather Than "lib", Because It Runs Inside The Build Instead Of Being Referenced By The Test Project -->
        <BuildOutputTargetFolder>build</BuildOutputTargetFolder>
        <!-- A Generator Plugin Package Deliberately Has No "lib" Folder -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <!-- Embed The Debug Symbols, Because Symbol Packages Expect Assemblies In "lib" -->
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <Title>Reqnroll.Retry.NUnit</Title>
        <PackageId>Retry.Reqnroll.NUnit</PackageId>
        <Version>1.1.0</Version>
        <Authors>Aleksander Reinhardt</Authors>
        <Copyright>Copyright (c) 2026 Aleksander Reinhardt</Copyright>
        <Summary>Adds automatic retry functionality to Reqnroll tests using NUnit.</Summary>
        <Description>A Reqnroll generator plugin that automatically adds the NUnit retry attribute to all generated BDD test methods, retrying on failed assertions and exceptions alike. Requires NUnit 4.5 or later. Supports configurable retry count via the ReqnrollRetryCount MSBuild property.</Description>
        <PackageTags>reqnroll;bdd;nunit;retry;testing;specflow</PackageTags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageLicenseFile>license</PackageLicenseFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/Xen0byte/Reqnroll.Retry</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Xen0byte/Reqnroll.Retry</PackageProjectUrl>
        <NeutralLanguage>en-GB</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <!-- Include Build Targets For Reqnroll Generator Plugin -->
        <None Include="NuGet/build/*.targets" Pack="true" PackagePath="build" />
        <None Include="../../readme.md" Pack="true" PackagePath="" />
        <None Include="../../license" Pack="true" PackagePath="" />
        <None Include="NuGet/icon.png" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <!-- Private, So The Package Declares No Dependencies, Because Reqnroll Provides These Assemblies When It Loads The Plugin -->
        <PackageReference Include="Reqnroll.CustomPlugin" Version="3.3.4" PrivateAssets="all" />
    </ItemGroup>

</Project>
