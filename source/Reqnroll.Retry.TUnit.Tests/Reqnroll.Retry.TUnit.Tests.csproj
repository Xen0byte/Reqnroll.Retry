<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RollForward>major</RollForward>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Generate The Code-Behind Outside The "Reqnroll" And "TUnit" Namespaces, Because Reqnroll.TUnit References "TUnit.Core" Without "global::", Which Would Otherwise Resolve To "Reqnroll.TUnit" Or "Reqnroll.Retry.TUnit" -->
        <RootNamespace>ReqnrollRetryTUnitTests</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Retry Count Override (Default Is 1 Retry) -->
        <ReqnrollRetryCount>2</ReqnrollRetryCount>
    </PropertyGroup>

    <ItemGroup>
        <!-- Expose ReqnrollRetryCount As Assembly Metadata For Runtime Access In Tests -->
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ReqnrollRetryCount</_Parameter1>
            <_Parameter2>$(ReqnrollRetryCount)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Test The Packed NuGet Package When A Package Version Is Given (Like In CI), Otherwise Test The Plugin Project Directly -->
    <PropertyGroup Condition="'$(ReqnrollRetryPackageVersion)' != ''">
        <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../nupkgs</RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup Condition="'$(ReqnrollRetryPackageVersion)' != ''">
        <PackageReference Include="Retry.Reqnroll.TUnit" Version="$(ReqnrollRetryPackageVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(ReqnrollRetryPackageVersion)' == ''">
        <!-- Build The Plugin Without Referencing It, And Collect Its Assembly As An Item, Like A Source Generator -->
        <ProjectReference Include="../Reqnroll.Retry.TUnit/Reqnroll.Retry.TUnit.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <OutputItemType>ReqnrollRetryGeneratorPluginAssembly</OutputItemType>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <!-- Import The Retry Targets File The Package Would Import, And Point It At The Plugin Project's Assembly -->
    <Import Project="../Reqnroll.Retry.TUnit/NuGet/build/Retry.Reqnroll.TUnit.targets" Condition="'$(ReqnrollRetryPackageVersion)' == ''" />

    <Target Name="UseReqnrollRetryGeneratorPluginProject" BeforeTargets="AddReqnrollRetryGeneratorPlugin" DependsOnTargets="ResolveProjectReferences" Condition="'$(ReqnrollRetryPackageVersion)' == ''">
        <PropertyGroup>
            <ReqnrollRetryGeneratorPluginPath>@(ReqnrollRetryGeneratorPluginAssembly)</ReqnrollRetryGeneratorPluginPath>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <Content Include="reqnroll.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Reqnroll.TUnit" Version="3.3.4" />
        <PackageReference Include="TUnit" Version="1.73.5" />
    </ItemGroup>

    <Target Name="DeleteBDDCodeBehindFiles" AfterTargets="AfterClean">
        <ItemGroup>
            <BDDCodeBehindFiles Include="**/*.feature.cs" />
        </ItemGroup>

        <Delete Files="@(BDDCodeBehindFiles)" />
    </Target>

</Project>
